# Copy to .env for local development. .env is git-ignored: never commit it.

# Firebase web app settings (Firebase Console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Main Admin login email. Used ONLY when deploying the security rules (npm run deploy:rules).
# It has no VITE_ prefix, so it is never put into the website code.
# Example: username "myadmin" → myadmin@astharesidency.app (pick your own, keep it private)
SUPER_ADMIN_EMAIL=
